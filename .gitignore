!/README.md
!/src/
!/tests/
/tests/*
!/tests/native/
!/tools/
/tools/*
!/tools/test-native.py
!/tools/test-native-host.py
!/tools/test-editor-native.py
!/tools/test-input.py
!/tools/test-io.py
!/tools/test-files.py
!/tools/test-text.py
!/tools/test-file-runtime.py
!/tools/test-runtime-layout.py
!/tools/test-params.py
!/tools/test-workers.py
!/tools/test-math.py
!/tools/test-output.py
!/tools/test-real.py
!/tools/package-native.py
!/tools/package-tf.py
