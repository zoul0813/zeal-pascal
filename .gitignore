# Publish the product, documentation, examples, and build/test tooling.
# Other root entries (builds, research, originals, reports, and local tools) stay local.
/*
!/.gitignore
!/CMakeLists.txt
!/Makefile
!/README.md
!/cmake/
!/docs/
!/examples/
!/libraries/
!/src/
!/tests/
!/tools/
!/units/

# Preserved CP/M reference corpus and research tooling are maintainer-local.
/tests/cpm/
/tools/local/

# Local IDE byproducts; shipped example .bin images remain tracked.
/examples/**/*.[Cc][Oo][Mm]
/examples/**/*.[Zz][Mm][Pp]
/examples/**/*.[Bb][Aa][Kk]
/examples/partsbin/parts.dat
/examples/measure/values.dat

# Host caches and desktop metadata are never source inputs.
__pycache__/
*.py[cod]
.DS_Store
