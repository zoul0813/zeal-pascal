program ZVBGraphics;
uses ZVB;
var Context: TGfxContext;
  Palette: array[0..3] of Word;
  Data, Result: array[0..63] of Byte;
  Sprites: array[0..1] of TGfxSprite;
  Descriptor: TDMADescriptor; Config: TDMADescriptorConfig;
  Mode, Mapping, SavedYLow, SavedYHigh: Byte; Opaque: Boolean; Z, I: Integer;
procedure Require(OK: Boolean);
begin if not OK then Z := 1 div Z end;
procedure ReadVRAM(Address: LongWord; Count: Word);
begin
  Config.ReadAddress := Address;
  Config.WriteAddress := DMAVirtToPhys(Result);
  Config.Length := Count; Config.Flags := DMADescLast;
  Require(DMAPrepareDescriptor(Descriptor, Config) = 0);
  Require(DMAStartTransfer(Descriptor) = 0)
end;
procedure RequireSolidTile(Address: LongWord; Size: Word; Color: Byte);
var Offset: Word;
begin
  Offset := 0;
  while Offset < Size do begin
    ReadVRAM(Address + LongWord(Offset), 64);
    for I := 0 to 63 do Require(Result[I] = Color);
    Offset := Offset + 64
  end
end;
begin
  Z := 0; Mode := Port[$9C]; Mapping := Port[$F0];
  GfxEnableScreen(False);
  Require(GfxInitialize(GfxMode3208Bit, Context) = 0);
  Require((Context.BitsPerPixel = 8) and (Context.BackupPage = Mapping));
  SavedYLow := Port[ZVB_CTRL_L0_SCR_Y_LOW];
  SavedYHigh := Port[ZVB_CTRL_L0_SCR_Y_HIGH];
  Port[ZVB_CTRL_L0_SCR_Y_LOW] := $23;
  Port[ZVB_CTRL_L0_SCR_Y_HIGH] := 1;
  Require(Port[ZVB_CTRL_L0_SCR_Y_LOW] = $23);
  Require(Port[ZVB_CTRL_L0_SCR_Y_HIGH] = 1);
  Port[ZVB_CTRL_L0_SCR_Y_LOW] := SavedYLow;
  Port[ZVB_CTRL_L0_SCR_Y_HIGH] := SavedYHigh;
  Require(GfxTilesetAddColorTile(Context, 255, 42) = 0);
  RequireSolidTile($11FF00, 256, 42);
  Require(GfxTilesetAddColorTile(Context, 256, 0) = GfxInvalidArg);
  Palette[0] := RGB888ToRGB565(255, 255, 255);
  Palette[1] := RGB888ToRGB565(255, 0, 0);
  Palette[2] := RGB888ToRGB565(0, 255, 0);
  Palette[3] := RGB888ToRGB565(0, 0, 255);
  Require(GfxPaletteLoad(Context, Palette, 8, 10) = 0);
  ReadVRAM($100E14, 8);
  Require((Result[0] = 255) and (Result[1] = 255));
  Require((Result[2] = 0) and (Result[3] = 248));
  Require((Result[4] = 224) and (Result[5] = 7));
  Require((Result[6] = 31) and (Result[7] = 0));
  FillChar(Result, 64, 0);
  Require(GfxPaletteRead(Result, 8, 10) = 0);
  Require((Result[0] = 255) and (Result[1] = 255));
  Require((Result[2] = 0) and (Result[3] = 248));
  Require((Result[4] = 224) and (Result[5] = 7));
  Require((Result[6] = 31) and (Result[7] = 0));
  Require(GfxPaletteRead(Result, 0, 0) = GfxInvalidArg);
  Require(GfxPaletteRead(Result, 3, 0) = GfxInvalidArg);
  Require(GfxPaletteRead(Result, 8, 255) = GfxInvalidArg);
  Require(Port[$F0] = Mapping);
  Require(GfxPaletteLoad(Context, Palette, 3, 0) = GfxInvalidArg);
  Require(GfxPaletteLoad(Context, Palette, 8, 255) = GfxInvalidArg);
  for I := 0 to 63 do Data[I] := I;
  { Raw copy straddles the VRAM physical bank boundary. }
  Require(GfxTilesetLoadNone(Context, Data, 64, $3FE0, 5, True) = 0);
  ReadVRAM($113FE0, 64);
  Require(Result[0] = 0);
  for I := 1 to 63 do Require(Result[I] = I + 5);
  Require(Port[$F0] = Mapping);
  Mem[Word(Addr(Opaque))] := 2;
  Require(GfxTilesetLoadNone(Context, Data, 2, 0, 5, Opaque) = 0);
  ReadVRAM($110000, 2); Require((Result[0] = 0) and (Result[1] = 6));
  Require(GfxTilemapLoad(Context, Data, 20, 0, 2, 3) = 0);
  ReadVRAM($1000F2, 20);
  for I := 0 to 19 do Require(Result[I] = I);
  Require(GfxTilemapPlace(Context, 29, 1, 5, 2) = 0);
  ReadVRAM($1010A5, 1); Require(Result[0] = 29);
  Require(GfxTilemapLoad(Context, Data, 20, 0, 70, 0) = GfxInvalidArg);
  Require(GfxTilemapPlace(Context, $7B, 1, 79, 39) = 0);
  Require(GfxTilemapPlace(Context, 1, 1, 80, 39) = GfxInvalidArg);
  Require(GfxTilemapPlace(Context, 1, 1, 79, 40) = GfxInvalidArg);
  ReadVRAM($101C7F, 1); Require(Result[0] = $7B);
  Require(Port[$F0] = Mapping);
  Require(GfxTilemapPlace(Context, 1, 2, 0, 0) = GfxInvalidArg);
  Sprites[0].X := 300; Sprites[0].Y := 200; Sprites[0].Tile := 7;
  Sprites[0].Flags := SpriteFlipX or SpritePalette(3); Sprites[0].Options := 2;
  Sprites[1] := Sprites[0]; Sprites[1].X := 16;
  Require(GfxSpriteRenderArray(Context, 4, Sprites, 2) = 0);
  ReadVRAM($102820, 16);
  Require((Result[0] = 200) and (Result[1] = 0));
  Require((Result[2] = 44) and (Result[3] = 1));
  Require((Result[4] = 7) and (Result[5] = 56) and (Result[6] = 2));
  Require(Result[10] = 16);
  Require(GfxSpriteSetX(Context, 4, 123) = 0);
  Require(GfxSpriteSetY(Context, 4, 456) = 0);
  Require(GfxSpriteSetXY(Context, 5, 77, 88) = 0);
  Require(GfxSpriteSetTile(Context, 4, 19) = 0);
  Require(GfxSpriteSetFlags(Context, 4, SpriteFlipY) = 0);
  ReadVRAM($102820, 16);
  Require((Result[0] = 200) and (Result[1] = 1));
  Require((Result[2] = 123) and (Result[4] = 19) and (Result[5] = 4));
  Require((Result[8] = 88) and (Result[10] = 77));
  Require(GfxSpriteRender(Context, 127, Sprites[0]) = 0);
  Require(GfxSpriteRenderArray(Context, 127, Sprites, 2) = GfxInvalidArg);
  Require(GfxSpriteSetX(Context, 128, 0) = GfxInvalidArg);
  Require(GfxInitialize(GfxMode3204Bit, Context) = 0);
  Require(Context.BitsPerPixel = 4);
  Require(GfxTilemapPlace(Context, $A1, 1, 0, 0) = 0);
  ReadVRAM($101000, 1); Require(Result[0] = $A1);
  Require(GfxTilesetAddColorTile(Context, 511, $33) = 0);
  RequireSolidTile($11FF80, 128, $33);
  Require(GfxTilesetAddColorTile(Context, 512, 0) = GfxInvalidArg);
  Require(GfxInitialize(GfxModeText640, Context) = GfxInvalidArg);
  Require(Port[$F0] = Mapping);
  Port[$9C] := Mode; GfxEnableScreen(True)
end.
