program Routines;
type text=string[12]; short=string[3]; shade=(red,green,blue);
var n,total,seen,rawptr,initialSP,initialRP,adjusted,recursiveAddress:integer; s:text; c:shade;
procedure forwarder(var x:integer); forward;
procedure outer;
var local:integer;
 procedure inner;
 begin local:=local+2 end;
begin local:=3; inner; n:=local end;
procedure forwarder;
begin x:=x+4 end;
function twice(x:integer):integer;
begin twice:=x*2 end;
procedure early;
begin n:=n+1; exit; n:=99 end;
function tick(x:integer):integer;
begin seen:=seen*10+x; tick:=x end;
procedure values(a:integer; v:short; b:integer);
begin
 if (a=1) and (b=2) and (v='abc') then total:=1;
 a:=99; b:=99; v:='xy';
end;
procedure chars(v:text; a:char; b:boolean; x:byte; tone:shade);
begin
 if (v='Q') and (a='z') and b and (x=255) and (tone=blue) then total:=total+1;
end;
procedure change(var v:text);
begin v:='changed' end;
procedure raw(var v);
begin rawptr:=addr(v) end;
procedure persistent;
const count:integer=0;
begin count:=count+1; n:=count end;
procedure cleanup(v:short; a:integer);
begin seen:=seen+1 end;
function yes:boolean;
begin yes:=true end;
function colour:shade;
begin colour:=blue end;
{$A-}
procedure memory(depth:integer);
var own,before:integer;
begin
 own:=depth;before:=recurptr;
 if before=initialRP then begin writeln('RECURPTR-ENTER-FAIL');halt end;
 if recursiveAddress=0 then recursiveAddress:=addr(own);
 if addr(own)<>recursiveAddress then begin writeln('RECURSIVE-ADDRESS-FAIL');halt end;
 if depth=0 then exit;
 memory(depth-1);
 if (recurptr<>before)or(own<>depth)then begin writeln('RECURPTR-RESTORE-FAIL');halt end
end;
function fact(x:integer):integer;
begin if x<=1 then fact:=1 else fact:=x*fact(x-1) end;
function recursive(x:integer):integer;
var local:integer;
 function helper(k:integer):integer;
 begin if k=0 then helper:=local else helper:=recursive(k-1)+local end;
begin local:=x*10; recursive:=helper(x) end;
function siblings(a:integer):integer;
 function left(x:integer):integer; forward;
 function right(x:integer):integer;
 begin if x=0 then right:=a else right:=left(x-1) end;
 function left;
 begin left:=right(x) end;
begin siblings:=left(3) end;
procedure recursive_values(v:short; depth:integer);
var saved:integer;
begin
 saved:=depth;
 if depth>0 then recursive_values('next',depth-1);
 if (saved=depth) and ((depth=2) and (v='fir') or (depth<2) and (v='nex')) then total:=total+1;
end;
{$A+}
var late:integer;
begin
 initialSP:=stackptr;initialRP:=recurptr;
 if initialSP-initialRP<>1024 then begin writeln('RECURPTR-DEFAULT-FAIL');halt end;
 recurptr:=initialRP-200;adjusted:=1+1;
 if recurptr<>initialRP-200 then begin writeln('RECURPTR-ASSIGN-FAIL');halt end;
 recurptr:=initialRP;recursiveAddress:=0;memory(3);
 if recurptr<>initialRP then begin writeln('RECURPTR-FINAL-FAIL');halt end;
 outer;
 if n=5 then writeln('LEXICAL-SCOPE-OK');
 forwarder(n);
 if n=9 then writeln('VAR-FORWARD-OK');
 if twice(n)=18 then writeln('VALUE-FUNCTION-OK');
 early;
 if n=10 then writeln('EXIT-OK');
 s:='abcdef'; total:=0; seen:=0;
 values(tick(1),s,tick(2));
 if (total=1) and (seen=12) and (s='abcdef') then writeln('VALUE-COPY-ORDER-OK');
 chars('Q','z',true,255,blue);
 if total=2 then writeln('ARGUMENT-LAYOUT-OK');
 change(s); raw(s);
 if (s='changed') and (rawptr=addr(s)) then writeln('VAR-STRING-UNTYPED-OK');
 persistent; persistent;
 if n=2 then writeln('LOCAL-TYPED-CONST-OK');
 if yes and (colour=blue) then writeln('SCALAR-RESULTS-OK');
 if fact(6)=720 then writeln('RECURSION-OK');
 if recursive(3)=60 then writeln('RECURSIVE-LEXICAL-OK');
 if siblings(42)=42 then writeln('SIBLING-STATIC-LINK-OK');
 total:=0; recursive_values('first',2);
 if total=3 then writeln('RECURSIVE-STRING-COPY-OK');
  seen:=0;
  for n:=1 to 1000 do begin cleanup('',n); cleanup('Q',n); cleanup('abcdefghijk',n) end;
  if seen=3000 then writeln('CALL-STACK-CLEANUP-OK');
 late:=1234;
 if late=1234 then writeln('LATE-GLOBAL-LAYOUT-OK');
end.
