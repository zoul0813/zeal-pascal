program StringFormatting;
type short=string[5];tiny=string[3];large=string[255];
     item=record text:short;guard:byte end;
     table=array[1..2]of short;
var s:short;t:tiny;big:large;rec:item;a:table;n,saved:integer;r:real;
    scratch:string[30];
procedure check(ok:boolean);
begin if not ok then halt end;
function select:integer;
begin str(-12:6,scratch);select:=2 end;
function width:integer;
begin r:=99;str(12:1,scratch);width:=5 end;
procedure parameter(var target:short);
begin str(3.5:5:1,target) end;
begin
 str(0,s);check(s='0');
 str(-32768,scratch);check(scratch='-32768');
 str(32767,s);check(s='32767');
 str(-123:6,s);check(s='  -12');
 str(12345:1,t);check(t='123');
 str(7:-1,s);check(s='7');
 str(7:0,s);check(s='7');
 str(7:255,big);check((length(big)=255)and(big[254]=' ')and(big[255]='7'));
 str(7:256,big);check((length(big)=255)and(big[254]=' ')and(big[255]='7'));
 str(7:32767,big);check((length(big)=255)and(big[255]='7'));
 str(7:300,s);check(s='     ');
 str(1.25,scratch);check(scratch='  1.2500000000E+00');
 str(1.25:5:2,s);check(s=' 1.25');
 str(-0.0001:1:2,s);check(s='-0.00');
 str(0.15:1:1,s);check(s='0.1');
 str(0.25:1:1,s);check(s='0.3');
 str(2.675:1:2,s);check(s='2.67');
 str(1.25:1:24,scratch);check(scratch='1.250000000000000000000000');
 str(1.25:1:25,scratch);check(scratch='1.3E+00');
 str(1.25:1:-1,scratch);check(scratch='1.3E+00');
 rec.guard:=99;str(123456789.0:1:0,rec.text);
 check((rec.text='12345')and(rec.guard=99));
 str(1.25:5:2,a[select]);check((a[2]=' 1.25')and(scratch='   -12'));
 r:=1.25;str(r:width:2,s);check((s=' 1.25')and(r=99)and(scratch='12'));
 parameter(s);check(s='  3.5');
 saved:=stackptr;
 for n:=1 to 20 do begin str(n:5,s);str(n/2:5:1,s) end;
 check(stackptr=saved);check(s=' 10.0');
 writeln('STR-FORMAT-ALL-OK');
end.
