program DiskCleanup;
type code=array[1..%ABI_LENGTH%]of byte;
  ints=file of integer;item=record f:ints end;pointer=^item;
var f:ints;p,markptr:pointer;i:integer;
  probe_layout:array[1..4]of byte; { Keep the assembled probe at $802D. }
const machine:code=(%ABI_BYTES%);
function dropfiles:integer;external $8033;
{$A-}%CHECKING%
procedure scoped;
var local:ints;
begin
  assign(local,'H:/CLEAN.DAT');rewrite(local);i:=7;write(local,i);
  if dropfiles<>1 then halt;
  %SCOPE_EXIT%
end{SCOPE};
{$I+}
begin
  recurptr:=stackptr-2048;
  if addr(machine)<>$802D then halt;
  %BODY%
end{PROGRAM}.
