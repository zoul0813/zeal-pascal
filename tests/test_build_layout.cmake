# Run with: zde exec cmake -DTEST_ROOT=/src/build -P /src/tests/test_build_layout.cmake
if(NOT DEFINED TEST_ROOT)
    message(FATAL_ERROR "TEST_ROOT is required")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
set(fixture "${TEST_ROOT}/layout-fixture-${nonce}")
if(EXISTS "${fixture}")
    message(FATAL_ERROR "Refusing to replace an existing layout fixture")
endif()
include(${CMAKE_CURRENT_LIST_DIR}/../cmake/BuildLayout.cmake)

function(assert_contents path expected)
    if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
        message(FATAL_ERROR "Expected file missing: ${path}")
    endif()
    file(READ "${path}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Unexpected contents: ${path}")
    endif()
endfunction()

file(MAKE_DIRECTORY "${fixture}/tests/1" "${fixture}/zptest.bin")
file(WRITE "${fixture}/zfragmenttest.bin" "new test")
file(WRITE "${fixture}/zfragmenttest.zpl" "test banks")
file(WRITE "${fixture}/zfragmenttest.map" "test map")
file(WRITE "${fixture}/zfragmenttest.banks.json" "test metadata")
file(WRITE "${fixture}/tests/1/zfragmenttest.bin" "previous test")
foreach(extension IN ITEMS ihx packed private runtime.json)
    file(WRITE "${fixture}/zfragmenttest.${extension}" "test ${extension}")
endforeach()
file(WRITE "${fixture}/zzvbtest.bin" "later test")
file(WRITE "${fixture}/zfragmenttest.pas" "user source")
file(WRITE "${fixture}/user.bin" "user program")
file(WRITE "${fixture}/zpascal.bin" "compiler")
file(WRITE "${fixture}/zpascal.zpl" "compiler banks")
foreach(unit IN ITEMS CRT SYSFILE ZVB)
    file(WRITE "${fixture}/${unit}.ZPU" "stock ${unit}")
endforeach()
file(CREATE_LINK "user.bin" "${fixture}/zfragmenttest.sym" SYMBOLIC RESULT symlink_result)

file(CREATE_LINK "missing-generation" "${fixture}/tests/2" SYMBOLIC RESULT archive_link_result)
if(archive_link_result STREQUAL "0")
    set(first 3)
    set(second 4)
else()
    set(first 2)
    set(second 3)
endif()
zp_prepare_build_layout("${fixture}" OFF)
foreach(extension IN ITEMS bin zpl map banks.json ihx packed private runtime.json)
    if(EXISTS "${fixture}/zfragmenttest.${extension}")
        message(FATAL_ERROR "Stale test output remains: ${extension}")
    endif()
endforeach()
assert_contents("${fixture}/tests/1/zfragmenttest.bin" "previous test")
assert_contents("${fixture}/tests/${first}/zfragmenttest.bin" "new test")
assert_contents("${fixture}/tests/${first}/zfragmenttest.zpl" "test banks")
assert_contents("${fixture}/tests/${first}/zfragmenttest.map" "test map")
assert_contents("${fixture}/tests/${first}/zfragmenttest.banks.json" "test metadata")
foreach(extension IN ITEMS ihx packed private runtime.json)
    assert_contents("${fixture}/tests/${first}/zfragmenttest.${extension}" "test ${extension}")
endforeach()
assert_contents("${fixture}/tests/${first}/zzvbtest.bin" "later test")
if(EXISTS "${fixture}/zzvbtest.bin")
    message(FATAL_ERROR "Later target was not archived")
endif()
assert_contents("${fixture}/zfragmenttest.pas" "user source")
assert_contents("${fixture}/user.bin" "user program")
assert_contents("${fixture}/zpascal.bin" "compiler")
assert_contents("${fixture}/zpascal.zpl" "compiler banks")
foreach(unit IN ITEMS CRT SYSFILE ZVB)
    assert_contents("${fixture}/${unit}.ZPU" "stock ${unit}")
endforeach()
if(NOT IS_DIRECTORY "${fixture}/assets" OR NOT IS_DIRECTORY "${fixture}/zptest.bin")
    message(FATAL_ERROR "Asset directory missing or user directory moved")
endif()
if(symlink_result STREQUAL "0" AND NOT IS_SYMLINK "${fixture}/zfragmenttest.sym")
    message(FATAL_ERROR "Symlink moved")
endif()

# Reconfiguration is idempotent, and repeated test builds preserve old archives.
zp_prepare_build_layout("${fixture}" OFF)
file(WRITE "${fixture}/zfragmenttest.bin" "another test")
zp_prepare_build_layout("${fixture}" ON)
assert_contents("${fixture}/zfragmenttest.bin" "another test")
zp_prepare_build_layout("${fixture}" OFF)
assert_contents("${fixture}/tests/${second}/zfragmenttest.bin" "another test")
assert_contents("${fixture}/tests/${first}/zfragmenttest.bin" "new test")
# Production layout setup must not require test definitions to be distributed.
set(zp_test_definitions "${fixture}/absent.cmake")
file(WRITE "${fixture}/zfragmenttest.bin" "no inventory")
zp_prepare_build_layout("${fixture}" OFF)
assert_contents("${fixture}/zfragmenttest.bin" "no inventory")
file(REMOVE_RECURSE "${fixture}")
message(STATUS "PASS: release layout, archive collisions, tests ON/OFF, user files and symlinks")
